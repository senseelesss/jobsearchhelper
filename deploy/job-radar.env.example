# Private deployed copy: /etc/job-radar.env (root:jobradar 0640).
JOB_RADAR_DB=/var/lib/job-radar/jobs.db
JOB_RADAR_CREDENTIALS=/var/lib/job-radar/secrets/credentials.json
JOB_RADAR_TOKEN=/var/lib/job-radar/secrets/token.json
JOB_RADAR_CANDIDATE_PROFILE=/var/lib/job-radar/candidate_profile.yaml
JOB_RADAR_SEARCHES=/etc/job-radar-searches.yaml
JOB_RADAR_OUTPUT=/var/lib/job-radar/output
JOB_RADAR_PAGES=1
JOB_RADAR_SOURCE_LIMIT=15
JOB_RADAR_DETAILS=0
JOB_RADAR_ENRICH_LIMIT=5
JOB_RADAR_EMAIL_LIMIT=100
JOB_RADAR_SCORE_LIMIT=5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_INPUT_COST_PER_MILLION=0.20
OPENAI_OUTPUT_COST_PER_MILLION=1.25
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_INPUT_BYTES=48000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Control Center requires the numeric owner ID to match the private Telegram chat.
TELEGRAM_OWNER_ID=
