[Unit]
Description=Job Radar daily collection and Telegram digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jobradar
WorkingDirectory=/opt/job-radar
EnvironmentFile=/etc/job-radar.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/var/cache/job-radar/browsers
Environment=HOME=/var/lib/job-radar
Environment=PYTHONPYCACHEPREFIX=/var/cache/job-radar/pycache
Environment=PYTHONUNBUFFERED=1
StateDirectory=job-radar
StateDirectoryMode=0700
CacheDirectory=job-radar
CacheDirectoryMode=0700
ExecStart=/bin/sh /opt/job-radar/deploy/run-daily.sh
TimeoutStartSec=25min
UMask=0077
StandardOutput=journal
StandardError=journal
