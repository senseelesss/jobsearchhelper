JOB_RADAR_DB=data/jobs.db
JOB_RADAR_CREDENTIALS=secrets/credentials.json
JOB_RADAR_TOKEN=secrets/token.json
JOB_RADAR_CANDIDATE_PROFILE=data/candidate_profile.yaml
# Optional absolute path to a customized copy of eligibility_rules.v1.json:
# JOB_RADAR_ELIGIBILITY_RULES=/absolute/private/job-radar-eligibility.json
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_INPUT_COST_PER_MILLION=0.20
OPENAI_OUTPUT_COST_PER_MILLION=1.25
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_INPUT_BYTES=48000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Required by interactive telegram-poll; numeric owner ID, matching private chat ID.
TELEGRAM_OWNER_ID=
